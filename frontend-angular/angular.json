{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "nexus-angular-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "nexus",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": { "outputPath": "dist/nexus-angular-web", "index": "src/index.html", "browser": "src/main.ts", "polyfills": ["zone.js"], "tsConfig": "tsconfig.app.json" }
        },
        "serve": { "builder": "@angular-devkit/build-angular:dev-server", "configurations": { "development": { "buildTarget": "nexus-angular-web:build" } }, "defaultConfiguration": "development" }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
